# ==========================================================================
# 07-restaurante · VARIABLES DE ENTORNO
# --------------------------------------------------------------------------
# CÓMO USARLO:
#   1. Copia este fichero:      copy .env.example .env
#   2. Rellena los valores que quieras activar.
#   3. Arranca:                 npm start
#
# Todo lo marcado como "demo" funciona sin tocar nada. Lo marcado como
# "opcional" solo hace falta si quieres la integración real.
# Los comentarios con # son ignorados.
# ==========================================================================

# --- Servidor ---------------------------------------------------------------
# Puerto y dirección donde escucha. Si otro programa usa el 3007, cambia aquí.
PORT=3007
HOST=127.0.0.1

# Raíz pública del sitio cuando esté en internet (para enlaces en correos).
SITE_URL=http://localhost:3007

# --- Base de datos ----------------------------------------------------------
# Ruta al fichero SQLite (relativa a la raíz de la plantilla). Se crea solo.
# Se recomienda añadirlo al .gitignore (ya está hecho).
DB_FILE=server/data/restaurante.db

# --- Administración ---------------------------------------------------------
# Token para consultar/borrar las reservas de la API.
# CAMBIALO antes de publicar. Se envía así:  x-admin-token: <valor>
ADMIN_TOKEN=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Reservas y disponibilidad ----------------------------------------------
# Correo del restaurante que recibe el aviso de cada reserva nueva.
CONTACTO_DESTINO=reservas@tudominio.com
# Bandeja interna de avisos. Si lo dejas vacío se usa CONTACTO_DESTINO.
EMAIL_RESERVAS=reservas@tudominio.com
# Máximo de envíos de reserva por IP y minuto (protección anti-spam).
LIMITE_RESERVAS=5
# Reservas máximas por hora y hueco (por defecto 4 a 30 min = 1 por hueco).
MAX_POR_HORA=4
# Minutos entre hueco y hueco de reserva (15, 30, 60…).
INTERVALO_RESERVA=30
# Comensales máximo por reserva (1 a N). El formulario ofrece hasta 12.
COMENSALES_MAX=12
# Días máximos por delante que se puede reservar (el HTML usa 90).
DIAS_MAX_RESERVA=90

# --- Envío de correos (OPCIONAL) -------------------------------------------
# Sin nada de abajo, la web funciona igualmente: la reserva se guarda en la
# base de datos y la API responde correo="demo".

# Opción A — Resend (API REST, no instala nada):
#   1. Crea cuenta en https://resend.com y una API key.
#   2. Pégala en la línea de abajo (ya está escrita, solo falta el valor).
RESEND_API_KEY=
# Remitente verificado en Resend (p. ej. "Casa Olivera <hola@tudominio.com>"):
EMAIL_DE=

# Opción B — SMTP (Gmail, Outlook, Mailgun…): requiere `npm install nodemailer`
#   Ej.: SMTP_HOST=smtp.gmail.com · SMTP_USUARIO=tu_correo@gmail.com
#        SMTP_CLAVE=tu_contraseña_de_aplicacion
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=

# --- CORS (OPCIONAL) -------------------------------------------------------
# Solo si vas a consumir esta API desde otra web/distinto dominio.
# CORS=0
# CORS_ORIGEN=https://tudominio.com

# --- Proxy inverso ------------------------------------------------------------
# TRUST_PROXY=0 (por defecto) es lo correcto si el servidor es público y NO hay
# proxy delante. Pon TRUST_PROXY=1 cuando escuches detrás de Caddy/nginx/
# Cloudflare (ver docs/DESPLIEGUE.md): así el límite anti-spam usa la IP real
# del visitante (X-Forwarded-For) en lugar de la IP del proxy, con la que
# TODOS compartirían el mismo límite.
TRUST_PROXY=0

# --- Cabecera Content-Security-Policy ----------------------------------------
# El servidor envía una CSP por defecto (solo recursos del propio sitio +
# Google Fonts), definida en server/lib/http.js. Para ajustarla o quitarla:
#   CSP=0                      → no enviar la cabecera
#   CSP=default-src 'self'; …  → valor propio (analíticas, formularios
#                                 externos, Stripe, vídeos incrustados…)
# CSP=
