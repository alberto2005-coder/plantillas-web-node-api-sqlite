# ==========================================================================
# 04-tienda · VARIABLES DE ENTORNO
# --------------------------------------------------------------------------
# CÓMO USARLO:
#   1. Copia este fichero:      copy .env.example .env
#   2. Rellena los valores que quieras activar.
#   3. Arranca:                 npm start
#
# Todo lo marcado como "demo" funciona sin tocar nada. Lo marcado como
# "opcional" solo hace falta si quieres la integración real.
# Los comentarios con # son ignorados.
# ==========================================================================

# --- Servidor ---------------------------------------------------------------
# Puerto y dirección donde escucha. Si otro programa usa el 3004, cambia aquí.
PORT=3004
HOST=127.0.0.1

# Raíz pública del sitio cuando esté en internet (para enlaces en correos).
SITE_URL=http://localhost:3004

# --- Base de datos ----------------------------------------------------------
# Ruta al fichero SQLite (relativa a la raíz de la plantilla). Se crea solo.
# Se recomienda añadirlo al .gitignore (ya está hecho).
DB_FILE=server/data/tienda.db

# --- Administración ---------------------------------------------------------
# Token para consultar los pedidos con la API (GET /api/pedidos).
# CAMBIALO antes de publicar. Se envía así:  x-admin-token: <valor>
ADMIN_TOKEN=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Precios, IVA y envío ---------------------------------------------------
# Moneda de la tienda (código ISO: EUR, USD, MXN…)
MONEDA=EUR
# Tipo de IVA en %, INCLUIDO en los precios (España: 21)
IVA=21
# Envío GRATIS si el subtotal llega a este importe (en €)
ENVIO_GRATIS_DESDE=50
# Coste del envío si no se llega a ese importe (en €)
ENVIO_COSTE=4.99

# --- Protección anti-spam (máx. peticiones por IP y minuto) -----------------
LIMITE_PEDIDO=10
LIMITE_NEWSLETTER=5

# --- Pagos con Stripe (OPCIONAL) --------------------------------------------
# Sin esta clave, POST /api/checkout devuelve { modo: 'demo' } y NO se cobra
# nada (la tienda sigue funcionando igual).
# Para activar: pega el valor después del = y reinicia. No hace falta instalar
# nada: la API de Stripe se llama con fetch (módulo nativo).
# 1. Crea cuenta en https://stripe.com y copia la clave secreta de prueba
#    (https://dashboard.stripe.com/apikeys) → empieza por sk_test_
STRIPE_SECRET_KEY=
# 2. Webhook (POST /api/stripe/webhook): en https://dashboard.stripe.com/webhooks
#    da de alta  <SITE_URL>/api/stripe/webhook  con los eventos
#    payment_intent.succeeded y payment_intent.payment_failed, y copia aquí el
#    secreto whsec_… (si no, el webhook rechaza con 400 y no se actualiza el pedido).
STRIPE_WEBHOOK_SECRET=

# --- Envío de correos (OPCIONAL) -------------------------------------------
# Sin nada de abajo, la web funciona igualmente: los correos no se envían y la
# API responde correo="demo".

# Opción A — Resend (API REST, no instala nada):
#   1. Crea cuenta en https://resend.com y una API key.
#   2. Pega la clave en la línea de abajo (ya está escrita, solo falta el valor).
RESEND_API_KEY=
# Remitente verificado en Resend (p. ej. "NovaTech Store <hola@tudominio.com>"):
EMAIL_DE=

# Correo del equipo que recibe el parte de cada pedido:
EMAIL_PEDIDOS=pedidos@tudominio.com

# Opción B — SMTP (Gmail, Outlook, Mailgun…): requiere `npm install nodemailer`
#   Ej.: SMTP_HOST=smtp.gmail.com · SMTP_USUARIO=tu_correo@gmail.com
#        SMTP_CLAVE=tu_contraseña_de_aplicacion
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=

# --- CORS (OPCIONAL) -------------------------------------------------------
# Solo si vas a consumir esta API desde otra web/distinto dominio.
# CORS=0
# CORS_ORIGEN=https://tudominio.com
