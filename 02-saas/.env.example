# ==========================================================================
# 02-saas (Fluxo) · VARIABLES DE ENTORNO
# --------------------------------------------------------------------------
# CÓMO USARLO:
#   1. Copia este fichero:      copy .env.example .env
#   2. Rellena SOLO lo que quieras activar: pega el valor después del =
#      (las claves ya están escritas sin # para que solo tengas que pegar).
#   3. Reinicia el servidor:    Ctrl + C  y luego  npm start
#
# Todo lo que quede VACÍO funciona en "modo demo": nada falla, pero tampoco
# se envía correo ni se cobra nada. Los comentarios con # se ignoran.
# ==========================================================================

# --- Servidor ---------------------------------------------------------------
# Puerto y dirección donde escucha. Si otro programa usa el 3000, cambia aquí.
PORT=3000
HOST=127.0.0.1

# Raíz pública del sitio cuando esté en internet.
# Se usa en el enlace de verificación del correo y en las URLs de Stripe
# (success_url / cancel_url). Ej: https://tudominio.com
SITE_URL=http://localhost:3000

# --- Base de datos ----------------------------------------------------------
# Ruta al fichero SQLite (relativa a la raíz de la plantilla). Se crea solo.
DB_FILE=server/data/saas.db

# --- Administración ---------------------------------------------------------
# Token para consultar las altas (GET /api/suscripciones) y firma de los
# enlaces de verificación. CAMBIALO antes de publicar.
# Se envía así:  x-admin-token: <valor>
ADMIN_TOKEN=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Altas de prueba --------------------------------------------------------
# Registros de prueba máximos por IP y minuto (protección anti-spam).
LIMITE_REGISTRO=10
# Días de la prueba gratuita que promete la landing y que aparecen en el correo.
DIAS_PRUEBA=14

# ==========================================================================
# OPCIONALES — déjalos vacíos para modo demo, pega el valor para activarlos
# ==========================================================================

# --- Envío de correos -------------------------------------------------------
# Vacío = el alta se guarda en la BD y la API responde correo="demo".
#
# Opción A — Resend (API REST, no hace falta instalar nada):
#   1. Cuenta en https://resend.com → API keys → copia la clave.
#   2. Verifica tu dominio en Resend (o usa un correo de tu cuenta).
RESEND_API_KEY=
# Remitente visible. Debe estar verificado en Resend. Ej:
#   EMAIL_DE="Fluxo <hola@tudominio.com>"
EMAIL_DE=
#
# Opción B — SMTP (Gmail, Outlook, Mailgun…): requiere  npm install nodemailer
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587, SMTP_USUARIO=tu correo,
#          SMTP_CLAVE=contraseña de aplicación (no la normal).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=

# --- Pagos con Stripe -------------------------------------------------------
# Vacío = POST /api/pago/sesion responde {modo:"demo"}: no se cobra nada.
# Pega tus claves y reinicia el servidor: el botón de pago abre el checkout
# real de Stripe (no hace falta instalar la librería, se llama por API REST).
#
# 1. Clave secreta → https://dashboard.stripe.com/apikeys  (empieza por sk_test_)
STRIPE_SECRET_KEY=
# 2. Id de un Precio recurrente → Stripe Dashboard → Products → Prices
#    (empieza por price_). Es lo que se cobra cada mes/año.
#    Solo necesitas el del plan que quieras cobrar; los demás puedes dejarlos
#    vacíos (si pulsas un plan sin precio, la API avisa de cuál falta).
STRIPE_PRICE_ID_BASICO=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_EMPRESA=
# 3. Secreto del webhook → https://dashboard.stripe.com/webhooks
#    Endpoint a dar de alta:  <SITE_URL>/api/stripe/webhook
#    Eventos: checkout.session.completed
#    (sin esta clave, la suscripción no se pone "activa" al pagar)
STRIPE_WEBHOOK_SECRET=

# --- CORS (OPCIONAL) -------------------------------------------------------
# Solo si vas a consumir esta API desde otra web/distinto dominio.
CORS=0
CORS_ORIGEN=*

# --- Proxy inverso ------------------------------------------------------------
# TRUST_PROXY=0 (por defecto) es lo correcto si el servidor es público y NO hay
# proxy delante. Pon TRUST_PROXY=1 cuando escuches detrás de Caddy/nginx/
# Cloudflare (ver docs/DESPLIEGUE.md): así el límite anti-spam usa la IP real
# del visitante (X-Forwarded-For) en lugar de la IP del proxy, con la que
# TODOS compartirían el mismo límite.
TRUST_PROXY=0

# --- Cabecera Content-Security-Policy ----------------------------------------
# El servidor envía una CSP por defecto (solo recursos del propio sitio +
# Google Fonts), definida en server/lib/http.js. Para ajustarla o quitarla:
#   CSP=0                      → no enviar la cabecera
#   CSP=default-src 'self'; …  → valor propio (analíticas, formularios
#                                 externos, Stripe, vídeos incrustados…)
# CSP=
